# OpenAI-compatible API key
OPENAI_API_KEY=your_api_key_here

# (Optional) Custom API base URL for compatible services such as Azure OpenAI or local models
# OPENAI_BASE_URL=https://api.openai.com/v1

# (Optional) Model name to use (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# (Optional) Flask port (default: 5000)
# PORT=5000

# (Optional) Enable Flask debug mode (default: false)
# FLASK_DEBUG=false
