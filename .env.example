# OpenAI-compatible API key
# 官方 OpenAI: https://platform.openai.com/api-keys
# 第三方兼容服务 (如 yyds168.net 次卡): 填入购买时获得的 sk-xxx 密钥
OPENAI_API_KEY=your_api_key_here

# (Optional) Custom API base URL for OpenAI-compatible services
# 官方 OpenAI (默认): https://api.openai.com/v1
# yyds168.net 兼容接口:  https://api.yyds168.net/v1
# OPENAI_BASE_URL=https://api.yyds168.net/v1

# (Optional) Model name to use (default: gpt-4o)
# 官方模型示例:   gpt-4o
# Gemini 模型示例: gemini-2.5-pro
# OPENAI_MODEL=gemini-2.5-pro

# (Optional) Flask port (default: 5000)
# PORT=5000

# (Optional) Enable Flask debug mode (default: false)
# FLASK_DEBUG=false
